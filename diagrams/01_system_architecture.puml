@startuml System Architecture

!define RECTANGLE class

title Multimodal Fraud Detection System - High Level Architecture

skinparam componentStyle rectangle
skinparam component {
    BackgroundColor<<external>> LightYellow
    BackgroundColor<<data>> LightBlue
    BackgroundColor<<model>> LightGreen
    BackgroundColor<<processing>> LightCoral
}

' External Data Sources
package "External Data Sources" <<external>> {
    component [Online Payments\nFraud Dataset] as fraud_data
    component [QR Code\nImages Dataset] as qr_data
}

' Data Layer
package "Data Layer" <<data>> {
    component [Tabular Data\n(CSV/DataFrame)] as tabular
    component [Image Data\n(PNG/JPG)] as images
    database "Processed Data\nStorage" as storage
}

' Processing Layer
package "Processing Layer" <<processing>> {
    component [FraudDataPreprocessor] as tab_processor
    component [QRCodePreprocessor] as img_processor
    component [MultimodalDataPreprocessor] as multi_processor
}

' Model Layer
package "Model Layer" <<model>> {
    component [Tabular Transformer\nEncoder] as tab_encoder
    component [Vision Transformer\nEncoder (ViT)] as img_encoder
    component [Cross-Modal\nAttention Fusion] as fusion
    component [Classification\nHead] as classifier
}

' Training & Inference
package "Training & Inference" {
    component [Training Pipeline\n(train.py)] as training
    component [Prediction Pipeline\n(predict.py)] as prediction
    component [Quick Start Demo\n(quick_start.py)] as demo
}

' Configuration
component [Configuration\n(config.py)] as config

' Model Storage
database "Model Storage\n(saved_models/)" as model_storage

' Relationships - Data Flow
fraud_data --> tabular : "Load"
qr_data --> images : "Load"

tabular --> tab_processor : "Process"
images --> img_processor : "Process"

tab_processor --> multi_processor : "Combine"
img_processor --> multi_processor : "Combine"

multi_processor --> storage : "Store"

storage --> tab_encoder : "Feed"
storage --> img_encoder : "Feed"

tab_encoder --> fusion : "Tabular\nFeatures"
img_encoder --> fusion : "Image\nFeatures"

fusion --> classifier : "Fused\nRepresentation"

' Training flow
config --> training : "Configure"
classifier --> training : "Build Model"
training --> model_storage : "Save Model"

' Inference flow
model_storage --> prediction : "Load Model"
classifier --> prediction : "Use Model"
prediction --> [Fraud/Normal\nPrediction] : "Output"

' Demo flow
config --> demo : "Configure"
demo --> training : "Train Demo"
demo --> prediction : "Predict Demo"

' Notes
note right of fusion
    **Cross-Modal Attention**
    - Tabular attends to Image
    - Image attends to Tabular
    - Bidirectional information flow
end note

note left of classifier
    **Output**
    - Binary Classification
    - 0: Normal Transaction
    - 1: Fraudulent Transaction
end note

@enduml
