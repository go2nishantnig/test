@startuml Attention Mechanism Detail

title Attention Mechanisms - Detailed View

skinparam component {
    BackgroundColor LightYellow
    BorderColor DarkOrange
}

' Multi-Head Self-Attention
rectangle "MultiHeadSelfAttention" {
    component "Input\n[batch, seq_len, d_model]" as mha_input
    
    rectangle "Linear Projections" {
        component "Wq: Dense(d_model)" as wq
        component "Wk: Dense(d_model)" as wk
        component "Wv: Dense(d_model)" as wv
    }
    
    component "Q\n[batch, seq_len, d_model]" as q
    component "K\n[batch, seq_len, d_model]" as k
    component "V\n[batch, seq_len, d_model]" as v
    
    component "Split to num_heads\nReshape & Transpose" as split
    
    component "Q_heads\n[batch, heads, seq, depth]" as q_heads
    component "K_heads\n[batch, heads, seq, depth]" as k_heads
    component "V_heads\n[batch, heads, seq, depth]" as v_heads
    
    component "MatMul(Q, K^T)" as matmul_qk
    component "QK^T\n[batch, heads, seq, seq]" as qk
    
    component "Scale by 1/√dk" as scale
    
    component "Softmax\n(attention weights)" as softmax
    
    component "MatMul(weights, V)" as matmul_v
    
    component "Attention Output\n[batch, heads, seq, depth]" as attn_out
    
    component "Concatenate heads\nReshape" as concat
    
    component "Output Projection\nDense(d_model)" as out_proj
    
    component "Output\n[batch, seq_len, d_model]" as mha_output
}

' Cross-Modal Attention
rectangle "CrossModalAttention" {
    component "Query Input\n(Modality A)\n[batch, seq_a, d_model]" as cm_query_input
    component "Key-Value Input\n(Modality B)\n[batch, seq_b, d_model]" as cm_kv_input
    
    rectangle "Linear Projections" as cm_proj {
        component "Wq: Dense(d_model)" as cm_wq
        component "Wk: Dense(d_model)" as cm_wk
        component "Wv: Dense(d_model)" as cm_wv
    }
    
    component "Q from A\n[batch, seq_a, d_model]" as cm_q
    component "K from B\n[batch, seq_b, d_model]" as cm_k
    component "V from B\n[batch, seq_b, d_model]" as cm_v
    
    component "Split & Reshape" as cm_split
    
    component "Scaled Dot-Product\nCross-Attention" as cm_attn
    
    component "Cross-Modal Output\n[batch, seq_a, d_model]" as cm_output
}

note right of cm_attn
    **Cross-Modal Mechanism:**
    
    Q comes from Modality A
    K, V come from Modality B
    
    This allows Modality A to
    "attend to" Modality B,
    extracting relevant information
    from the other modality.
    
    Example:
    - Tabular attends to Image
    - Q: transaction features
    - K,V: image patch features
    - Output: tabular features
      enriched with image context
end note

' Masked Multi-Head Attention
rectangle "MaskedMultiHeadAttention" {
    component "Input\n[batch, seq_len, d_model]" as masked_input
    
    component "Create Look-Ahead Mask\nUpper triangular = -∞" as mask_create
    
    component "Q, K, V Projections" as masked_proj
    
    component "Scaled Dot-Product\n+ Add Mask" as masked_attn
    
    note right of masked_attn
        **Causal Masking:**
        
        Position i can only attend to
        positions ≤ i (past positions)
        
        Prevents "looking ahead"
        in sequence generation
        
        Used in decoder blocks
    end note
    
    component "Masked Output\n[batch, seq_len, d_model]" as masked_output
}

' Self-Attention Flow
mha_input --> wq
mha_input --> wk
mha_input --> wv

wq --> q
wk --> k
wv --> v

q --> split
k --> split
v --> split

split --> q_heads
split --> k_heads
split --> v_heads

q_heads --> matmul_qk
k_heads --> matmul_qk
matmul_qk --> qk

qk --> scale
scale --> softmax
softmax --> matmul_v
v_heads --> matmul_v

matmul_v --> attn_out
attn_out --> concat
concat --> out_proj
out_proj --> mha_output

' Cross-Modal Flow
cm_query_input --> cm_wq
cm_kv_input --> cm_wk
cm_kv_input --> cm_wv

cm_wq --> cm_q
cm_wk --> cm_k
cm_wv --> cm_v

cm_q --> cm_split
cm_k --> cm_split
cm_v --> cm_split

cm_split --> cm_attn
cm_attn --> cm_output

' Masked Attention Flow
masked_input --> mask_create
masked_input --> masked_proj
mask_create --> masked_attn
masked_proj --> masked_attn
masked_attn --> masked_output

note bottom of mha_input
    **Attention Formula:**
    
    Attention(Q, K, V) = softmax(QK^T / √dk) × V
    
    where:
    - Q: Query matrix
    - K: Key matrix
    - V: Value matrix
    - dk: dimension of key vectors
    
    Multi-Head splits Q, K, V into h heads,
    computes attention in parallel,
    then concatenates results.
end note

note top of split
    **Head Splitting:**
    
    d_model = 64
    num_heads = 4
    depth = 64 / 4 = 16
    
    Each head operates on
    a 16-dimensional subspace
end note

@enduml
