@startuml Training Flow Sequence

title Training Flow - Multimodal Model Training Sequence

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor User
participant "train.py" as train
participant "Config" as config
participant "MultimodalDataPreprocessor" as preprocessor
participant "FraudDataPreprocessor" as tab_prep
participant "QRCodePreprocessor" as img_prep
participant "MultimodalFraudDetectionTransformer" as model_builder
participant "TransformerBlock" as block
participant "CrossModalTransformerBlock" as cross_block
participant "Keras Model" as keras_model
database "Model Storage" as storage
database "Logs" as logs

User -> train : python train.py --mode multimodal

activate train

train -> config : Load MODEL_CONFIG, TRAINING_CONFIG
config --> train : Configuration loaded

train -> preprocessor : Create MultimodalDataPreprocessor(image_size)
activate preprocessor
preprocessor -> tab_prep : Create FraudDataPreprocessor()
preprocessor -> img_prep : Create QRCodePreprocessor(image_size)
preprocessor --> train : Preprocessor ready

train -> preprocessor : prepare_train_test_data(test_size, n_samples)
activate preprocessor

preprocessor -> tab_prep : generate_synthetic_fraud_data(n_samples)
tab_prep --> preprocessor : X_tabular_raw, y

preprocessor -> img_prep : generate_synthetic_qr_images(n_samples)
img_prep --> preprocessor : X_images_raw

preprocessor -> tab_prep : preprocess_data(X_tabular_raw, y, fit_scaler=True)
tab_prep --> preprocessor : X_tabular_processed

preprocessor -> img_prep : preprocess_images(X_images_raw)
img_prep --> preprocessor : X_images_processed

preprocessor -> preprocessor : train_test_split()
preprocessor --> train : {X_train_tabular, X_train_images,\n X_test_tabular, X_test_images,\n y_train, y_test}
deactivate preprocessor

train -> model_builder : Create MultimodalFraudDetectionTransformer(config)
activate model_builder

train -> model_builder : build_model()

model_builder -> model_builder : build_tabular_encoder()
activate model_builder
model_builder -> block : Create TransformerBlock(d_model, num_heads, ...)
block --> model_builder : Tabular encoder blocks
model_builder --> model_builder : Tabular encoder built
deactivate model_builder

model_builder -> model_builder : build_image_encoder()
activate model_builder
model_builder -> block : Create TransformerBlock(d_model, num_heads, ...)
block --> model_builder : Image encoder blocks
model_builder --> model_builder : Image encoder built
deactivate model_builder

model_builder -> model_builder : build_cross_modal_fusion()
activate model_builder
model_builder -> cross_block : Create CrossModalTransformerBlock(...)
cross_block --> model_builder : Cross-modal fusion blocks
model_builder --> model_builder : Fusion layer built
deactivate model_builder

model_builder -> keras_model : Create Keras Model(inputs, outputs)
keras_model --> model_builder : Model compiled

model_builder --> train : model
deactivate model_builder

train -> keras_model : compile(optimizer, loss, metrics)
keras_model --> train : Model compiled

train -> keras_model : fit(X_train, y_train,\n validation_data=(X_test, y_test),\n epochs, batch_size, callbacks)

loop For each epoch
    keras_model -> keras_model : Forward pass through model
    keras_model -> keras_model : Calculate loss
    keras_model -> keras_model : Backward pass (gradient descent)
    keras_model -> keras_model : Update weights
    keras_model -> logs : Write metrics
    
    alt Early stopping triggered
        keras_model --> train : Training stopped early
    end
end

keras_model --> train : Training complete

train -> keras_model : evaluate(X_test, y_test)
keras_model --> train : Test metrics

train -> storage : Save model (.keras file)
train -> storage : Save preprocessor (pickle)
storage --> train : Files saved

train --> User : Training complete!\nModel saved to models/saved_models/

deactivate train

note right of preprocessor
    **Data Preparation:**
    1. Generate/load data
    2. Preprocess tabular features
    3. Preprocess images
    4. Create train/test splits
end note

note right of model_builder
    **Model Architecture:**
    1. Tabular Encoder (Transformer)
    2. Image Encoder (ViT)
    3. Cross-Modal Fusion
    4. Classification Head
end note

note right of keras_model
    **Training Process:**
    - Adam optimizer
    - Binary crossentropy loss
    - Early stopping
    - Learning rate reduction
    - TensorBoard logging
end note

@enduml
